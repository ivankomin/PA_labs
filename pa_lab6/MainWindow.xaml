<Window x:Class="pa_lab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pa_lab6"
        mc:Ignorable="d"
        Title="MVC Genetic Algorithm Optimizer (.NET 9.0)" Height="850" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#FAFAFA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,15">
            <TextBlock Text="Налаштування параметрів Генетичного Алгоритму (MVC)" 
                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333"/>
            <TextBlock Text="Метод: Покоординатний спуск | Граф: 300 вершин | Задача: Vertex Cover" 
                       FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <Border x:Name="SummaryCard" Grid.Row="1" Visibility="Collapsed" 
                Margin="5,0,5,15" BorderBrush="#4CAF50" BorderThickness="1" 
                CornerRadius="8" Background="#F1F8E9" Padding="15">
            <StackPanel>
                <TextBlock Text="Підсумки оптимізації" FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,0,0,10"/>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Базові параметри:" VerticalAlignment="Center" Foreground="#555"/>
                    <ProgressBar x:Name="BarBefore" Grid.Column="1" Height="18" Value="0" Maximum="100" 
                                 Foreground="Gray" Background="#E0E0E0" BorderThickness="0" Margin="10,0"/>
                    <TextBlock x:Name="TxtBefore" Grid.Column="2" Text="0" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Кращі параметри:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#333"/>
                    <ProgressBar x:Name="BarAfter" Grid.Column="1" Height="18" Value="0" Maximum="100" 
                                 Foreground="#4CAF50" Background="#E0E0E0" BorderThickness="0" Margin="10,0"/>
                    <TextBlock x:Name="TxtAfter" Grid.Column="2" Text="0" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>

                <TextBlock x:Name="TxtImprovement" Text="Ефективність підвищено на 0%" 
                           HorizontalAlignment="Right" FontStyle="Italic" Foreground="#2E7D32" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Margin="5,0,5,15" Padding="15" CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" Opacity="0.1" BlurRadius="5"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/> <ColumnDefinition Width="*"/>   </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                           Text="{Binding ParameterName, StringFormat='Дослідження параметру: {0}'}" 
                                           FontWeight="Bold" FontSize="16" Margin="0,0,0,15" Foreground="#007ACC"/>

                                <DataGrid Grid.Row="1" Grid.Column="0" 
                                          ItemsSource="{Binding DataPoints}" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False" 
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="White"
                                          BorderThickness="1" BorderBrush="#EEE"
                                          Height="200" VerticalAlignment="Top">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Значення" Binding="{Binding XValue}" Width="*"/>
                                        <DataGridTextColumn Header="Вершин (ЦФ)" Binding="{Binding YResult}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="1" Grid.Column="1" Margin="20,0,0,0" 
                                        BorderBrush="#EEE" BorderThickness="1" Background="White" Height="200">
                                    <Canvas x:Name="GraphCanvas" Background="Transparent" Loaded="Chart_Loaded"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button x:Name="BtnStart" Content="Запустити оптимізацію" 
                    Click="BtnStart_Click" Height="45" FontSize="16" FontWeight="SemiBold"
                    Background="#007ACC" Foreground="White" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <ProgressBar x:Name="ProgressBar" Height="45" IsIndeterminate="True" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>