<Window x:Class="pa_lab6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MVC Genetic Algorithm Optimizer (.NET 9.0)" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Налаштування параметрів Генетичного Алгоритму (MVC)" 
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Метод: Покоординатний спуск | Граф: 300 вершин" 
                       FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="ResultsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="10" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/> <ColumnDefinition Width="2*"/> </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                                           Text="{Binding ParameterName, StringFormat='Дослідження параметру: {0}'}" 
                                           FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#007ACC"/>

                                <DataGrid Grid.Row="1" Grid.Column="0" 
                                          ItemsSource="{Binding DataPoints}" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False" 
                                          HeadersVisibility="Column"
                                          Height="200" VerticalAlignment="Top">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Значення" Binding="{Binding XValue}" Width="*"/>
                                        <DataGridTextColumn Header="Покриття (ЦФ)" Binding="{Binding YResult}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="1" Grid.Column="1" Margin="20,0,0,0" BorderBrush="Black" BorderThickness="1" Height="200">
                                    <Canvas x:Name="GraphCanvas" Background="White" Loaded="Chart_Loaded"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="BtnStart" Content="Запустити оптимізацію" 
                Click="BtnStart_Click" Height="40" Margin="0,10,0,0" FontSize="16"/>
        <ProgressBar Grid.Row="2" x:Name="ProgressBar" Height="40" Margin="0,10,0,0" 
                     IsIndeterminate="True" Visibility="Collapsed"/>
    </Grid>
</Window>