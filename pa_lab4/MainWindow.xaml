<Window x:Class="pa_lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HolovchenkoSQL" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="100"/>  </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                    <TextBlock Text="Key (int):"/>
                    <TextBox x:Name="txtKey" Width="100" Height="25"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,20,0">
                    <TextBlock Text="Data (string):"/>
                    <TextBox x:Name="txtValue" Width="150" Height="25"/>
                </StackPanel>

                <Button Content="Add New" Click="BtnAdd_Click" Width="80" Height="30" Margin="5"/>
                <Button Content="Find" Click="BtnSearch_Click" Width="80" Height="30" Margin="5"/>
                <Button Content="Edit" Click="BtnEdit_Click" Width="80" Height="30" Margin="5"/>
                <Button Content="Delete" Click="BtnDelete_Click" Width="80" Height="30" Margin="5"/>

                <Rectangle Width="2" Height="30" Fill="Gray" Margin="15,0"/>

                <Button Content="Gen 10k" Click="BtnGen_Click" Width="80" Height="30" Margin="5" Background="LightBlue"/>
                <Button Content="Test" Click="BtnTest_Click" Width="80" Height="30" Margin="5" Background="LightGreen"/>
            </WrapPanel>
        </Border>

        <DataGrid x:Name="dgData" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                  BorderBrush="Gray" BorderThickness="1">
            </DataGrid>

        <GroupBox Header="Results" Grid.Row="2" Margin="0,10,0,0">
            <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                     FontFamily="Consolas" TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>