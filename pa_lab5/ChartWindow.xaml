<Window x:Class="pa_lab5.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детальний графік збіжності" Height="600" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/>    </Grid.ColumnDefinitions>

        <TextBlock Text="Залежність якості (кількості кольорів) від ітерацій" 
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <Canvas Name="AxisY" Grid.Row="1" Grid.Column="0" Width="40" Margin="0,0,5,0"/>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Background="#FAFAFA">
            <Canvas Name="PlotCanvas" ClipToBounds="True" SizeChanged="PlotCanvas_SizeChanged"/>
        </Border>

        <Canvas Name="AxisX" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,5,0,0"/>
    </Grid>
</Window>