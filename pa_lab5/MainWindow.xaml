<Window x:Class="pa_lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ABC Graph Coloring (Circular Layout)" Height="800" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Padding="10">
            <StackPanel>
                <TextBlock Text="Налаштування" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                
                <TextBlock Text="Вершин: 150"/>
                <TextBlock Text="Степінь: 1 - 30"/>
                <TextBlock Text="Бджіл: 25 (3 розвідники)"/>
                <TextBlock Text="Ітерацій: 1000"/>
                
                <Button Name="BtnRun" Content="Запустити Алгоритм" Height="40" Margin="0,20,0,0" Click="BtnRun_Click"/>
                
                <Button Name="BtnShowChart" Content="📈 Показати графік" Height="30" Margin="0,10,0,0" Click="BtnShowChart_Click" IsEnabled="False"/>
                
                <Separator Margin="0,20"/>
                
                <TextBlock Text="Статистика:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Name="TxtStatus" Text="Очікування..." TextWrapping="Wrap"/>
                <TextBlock Name="TxtResult" Text="" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" Foreground="DarkBlue"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <Canvas Name="GraphCanvas" Background="White" ClipToBounds="True"/>
            </Border>
        </Grid>
    </Grid>
</Window>